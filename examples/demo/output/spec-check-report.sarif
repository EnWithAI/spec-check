{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "spec-check",
          "semanticVersion": "0.2.0",
          "rules": [
            {
              "id": "adr-section-missing",
              "name": "adr-section-missing",
              "shortDescription": {
                "text": "ADR section missing"
              },
              "fullDescription": {
                "text": "The decision record has no status, or no heading for one of the required sections (default: context, decision, consequences)."
              },
              "help": {
                "text": "Add the missing sections so readers can see why the decision was made and what it changes."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "integrity",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "adr-status-invalid",
              "name": "adr-status-invalid",
              "shortDescription": {
                "text": "ADR status not in the allowed set"
              },
              "fullDescription": {
                "text": "The status is not one of the configured values, so tools and readers cannot tell if it applies."
              },
              "help": {
                "text": "Use an allowed status (for example accepted or superseded), or add this status to `adr_statuses`."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "integrity",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "adr-supersede-dangling",
              "name": "adr-supersede-dangling",
              "shortDescription": {
                "text": "ADR superseded by a record that is not there"
              },
              "fullDescription": {
                "text": "The record points at a replacement that is not among the analyzed ADRs."
              },
              "help": {
                "text": "Fix the link or number, add the replacing ADR, or include its folder in the run."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "integrity",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "ai-governance-missing",
              "name": "ai-governance-missing",
              "shortDescription": {
                "text": "AI component without an AI-governance section"
              },
              "fullDescription": {
                "text": "The package uses AI vocabulary but has no AI-governance heading. The default headings are not a compliance claim."
              },
              "help": {
                "text": "Add a section on intended use, evaluation, human oversight, data provenance and fallback, or confirm no AI component is involved."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "coverage",
                "status": "hypothesis"
              }
            },
            {
              "id": "dangling-reference",
              "name": "dangling-reference",
              "shortDescription": {
                "text": "Reference to an undefined ID"
              },
              "fullDescription": {
                "text": "The ID is mentioned but defined in none of the analyzed files."
              },
              "help": {
                "text": "Define the referenced requirement, fix the ID, or include the file that defines it in the run."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "integrity",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "design-package-incomplete",
              "name": "design-package-incomplete",
              "shortDescription": {
                "text": "Required design-package document missing"
              },
              "fullDescription": {
                "text": "No file under the working directory matches the globs of a required document."
              },
              "help": {
                "text": "Add the document, or change `required_documents` if your package does not need it."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "coverage",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "duplicate-id",
              "name": "duplicate-id",
              "shortDescription": {
                "text": "Requirement ID defined more than once"
              },
              "fullDescription": {
                "text": "Two definitions share one ID, so references to it are ambiguous."
              },
              "help": {
                "text": "Give each requirement a unique ID and update references."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "integrity",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "missing-edge-cases",
              "name": "missing-edge-cases",
              "shortDescription": {
                "text": "No edge or negative cases"
              },
              "fullDescription": {
                "text": "The file has requirements but no edge-case section with content and no error, rejection or boundary wording."
              },
              "help": {
                "text": "Describe what happens on invalid input, failure, limits and empty states, or confirm none apply."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "coverage",
                "status": "hypothesis"
              }
            },
            {
              "id": "missing-non-functional",
              "name": "missing-non-functional",
              "shortDescription": {
                "text": "No non-functional constraint mentioned"
              },
              "fullDescription": {
                "text": "Nothing mentions performance, security, privacy, accessibility, reliability or retention."
              },
              "help": {
                "text": "State the quality constraints that matter for this feature, or confirm none apply."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "coverage",
                "status": "hypothesis"
              }
            },
            {
              "id": "missing-owner",
              "name": "missing-owner",
              "shortDescription": {
                "text": "No owner recorded"
              },
              "fullDescription": {
                "text": "Neither an `owner` front-matter key nor an **Owner**: line names who decides open questions."
              },
              "help": {
                "text": "Add `owner:` front matter or an **Owner**: line."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "ownership",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "needs-clarification",
              "name": "needs-clarification",
              "shortDescription": {
                "text": "Unresolved [NEEDS CLARIFICATION] marker"
              },
              "fullDescription": {
                "text": "The spec itself marks this point as unresolved; building from it means guessing."
              },
              "help": {
                "text": "Resolve the question with the requirement owner and replace the marker with the decision."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "clarity",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "nfr-without-slo",
              "name": "nfr-without-slo",
              "shortDescription": {
                "text": "Service-level NFR without a measurable target"
              },
              "fullDescription": {
                "text": "The requirement names a service-level quality but no number with a percentile, percentage or measurement window."
              },
              "help": {
                "text": "State the target as value + unit + window or percentile, for example \"p95 under 300 ms over 28 days\"."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "verifiability",
                "status": "hypothesis"
              }
            },
            {
              "id": "open-marker",
              "name": "open-marker",
              "shortDescription": {
                "text": "TBD/TODO marker in a requirement, criterion or scenario"
              },
              "fullDescription": {
                "text": "The text says it is unfinished."
              },
              "help": {
                "text": "Finish the statement or move the open point to a tracked question."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "clarity",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "scenario-incomplete",
              "name": "scenario-incomplete",
              "shortDescription": {
                "text": "Scenario missing Given, When or Then"
              },
              "fullDescription": {
                "text": "An acceptance scenario lacks a precondition, an action or an expected outcome, or has them out of order."
              },
              "help": {
                "text": "Complete the scenario so it states the starting state, the action and the observable outcome."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "verifiability",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "security-considerations-missing",
              "name": "security-considerations-missing",
              "shortDescription": {
                "text": "No security section in the design package"
              },
              "fullDescription": {
                "text": "None of the package's documents has a heading containing a configured security word. The content of such a section is not assessed."
              },
              "help": {
                "text": "Add a security or threat-model section, or confirm in one that no security concerns apply."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "coverage",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "slo-without-sli",
              "name": "slo-without-sli",
              "shortDescription": {
                "text": "SLO without an indicator"
              },
              "fullDescription": {
                "text": "The statement gives an objective but does not say what is measured."
              },
              "help": {
                "text": "Name the indicator, for example \"99.9% of requests succeed over 30 days\"."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "verifiability",
                "status": "hypothesis"
              }
            },
            {
              "id": "story-without-scenarios",
              "name": "story-without-scenarios",
              "shortDescription": {
                "text": "User story without acceptance scenarios"
              },
              "fullDescription": {
                "text": "Nothing in the story's section says how to verify it."
              },
              "help": {
                "text": "Add at least one Given/When/Then acceptance scenario to the story."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "verifiability",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "template-placeholder",
              "name": "template-placeholder",
              "shortDescription": {
                "text": "Template placeholder left in the spec"
              },
              "fullDescription": {
                "text": "Placeholder text from the spec template was not replaced with real content."
              },
              "help": {
                "text": "Replace the placeholder with the actual content or delete the line."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "clarity",
                "status": "verified_static_fact"
              }
            },
            {
              "id": "unmeasurable-criterion",
              "name": "unmeasurable-criterion",
              "shortDescription": {
                "text": "Success criterion without a measure"
              },
              "fullDescription": {
                "text": "The criterion has no number, threshold or universal quantifier, so success cannot be checked."
              },
              "help": {
                "text": "State how success is measured: a target value, a percentage or an all/none condition."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "verifiability",
                "status": "hypothesis"
              }
            },
            {
              "id": "vague-term",
              "name": "vague-term",
              "shortDescription": {
                "text": "Vague term without a measure"
              },
              "fullDescription": {
                "text": "A term such as 'fast' or 'user-friendly' is used without a number that makes it testable."
              },
              "help": {
                "text": "Add a measurable threshold (for example a latency, count or percentage) or confirm the wording is intended."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "clarity",
                "status": "hypothesis"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "story-without-scenarios",
          "ruleIndex": 16,
          "level": "warning",
          "message": {
            "text": "User story has no acceptance scenario. Add at least one Given/When/Then acceptance scenario to the story."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "specs/001-team-invites/spec.md"
                },
                "region": {
                  "startLine": 20,
                  "endLine": 20
                }
              }
            }
          ],
          "partialFingerprints": {
            "specCheckFindingId/v1": "story-without-scenarios:87ea94ba"
          },
          "properties": {
            "status": "verified_static_fact",
            "confidence": "high",
            "is_heuristic": false,
            "requirement_ids": []
          }
        },
        {
          "ruleId": "vague-term",
          "ruleIndex": 19,
          "level": "note",
          "message": {
            "text": "Vague term \"quickly\" without a measure in FR-002. Add a measurable threshold (for example a latency, count or percentage) or confirm the wording is intended."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "specs/001-team-invites/spec.md"
                },
                "region": {
                  "startLine": 33,
                  "endLine": 33
                }
              }
            }
          ],
          "partialFingerprints": {
            "specCheckFindingId/v1": "vague-term:2fdf4c5f"
          },
          "properties": {
            "status": "hypothesis",
            "confidence": "medium",
            "is_heuristic": true,
            "requirement_ids": [
              "FR-002"
            ]
          }
        },
        {
          "ruleId": "dangling-reference",
          "ruleIndex": 4,
          "level": "warning",
          "message": {
            "text": "FR-009 is referenced but not defined. Define the referenced requirement, fix the ID, or include the file that defines it in the run."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "specs/001-team-invites/spec.md"
                },
                "region": {
                  "startLine": 34,
                  "endLine": 34
                }
              }
            }
          ],
          "partialFingerprints": {
            "specCheckFindingId/v1": "dangling-reference:4aeb7a47"
          },
          "properties": {
            "status": "verified_static_fact",
            "confidence": "high",
            "is_heuristic": false,
            "requirement_ids": [
              "FR-003"
            ]
          }
        },
        {
          "ruleId": "needs-clarification",
          "ruleIndex": 10,
          "level": "error",
          "message": {
            "text": "Unresolved clarification in FR-004. Resolve the question with the requirement owner and replace the marker with the decision."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "specs/001-team-invites/spec.md"
                },
                "region": {
                  "startLine": 35,
                  "endLine": 35
                }
              }
            }
          ],
          "partialFingerprints": {
            "specCheckFindingId/v1": "needs-clarification:589a9698"
          },
          "properties": {
            "status": "verified_static_fact",
            "confidence": "high",
            "is_heuristic": false,
            "requirement_ids": [
              "FR-004"
            ]
          }
        },
        {
          "ruleId": "unmeasurable-criterion",
          "ruleIndex": 18,
          "level": "warning",
          "message": {
            "text": "SC-002 has no measurable target. State how success is measured: a target value, a percentage or an all/none condition."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "specs/001-team-invites/spec.md"
                },
                "region": {
                  "startLine": 40,
                  "endLine": 40
                }
              }
            }
          ],
          "partialFingerprints": {
            "specCheckFindingId/v1": "unmeasurable-criterion:804977b3"
          },
          "properties": {
            "status": "hypothesis",
            "confidence": "medium",
            "is_heuristic": true,
            "requirement_ids": [
              "SC-002"
            ]
          }
        }
      ],
      "properties": {
        "policy": "fail",
        "limitations": [
          "english-lexicon",
          "not-checked"
        ]
      }
    }
  ]
}
